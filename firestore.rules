rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if false;
      match /settings/{doc} {
        allow read, write: if false;
      }
      match /categories/{catId} {
        allow read, write: if false;
      }
      match /transactions/{txId} {
        allow read, write: if false;
      }
    }
  }
}
